<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Main" picking-mode="Ignore" style="flex-grow: 1;">
        <ui:VisualElement name="Lungs" picking-mode="Ignore" style="width: 100px; height: 100px; aspect-ratio: auto; bottom: 230px; left: 45px; min-width: 120px; min-height: 120px; max-height: none; max-width: none; top: auto; right: auto; position: absolute; align-items: center; justify-content: center; align-content: center; flex-wrap: nowrap; align-self: center;">
            <Lungs name="Lungs" inner-radius="40" thickness="8" outer-radius="75" stroke-col="rgb(85, 95, 71)" picking-mode="Ignore" style="width: 100%; height: 100%; position: absolute;">
                <Bindings>
                    <ui:DataBinding property="innerRadius" data-source-path="_innerRadius" data-source-type="BreathController, Assembly-CSharp" binding-mode="ToTarget"/>
                    <ui:DataBinding property="outerRadius" data-source-path="_outerRadius" data-source-type="BreathController, Assembly-CSharp" binding-mode="ToTarget"/>
                    <ui:DataBinding property="thickness" data-source-path="_thickness" data-source-type="BreathController, Assembly-CSharp" binding-mode="ToTarget"/>
                    <ui:DataBinding property="strokeCol" data-source-path="_strokeCol" data-source-type="BreathController, Assembly-CSharp" binding-mode="ToTarget"/>
                </Bindings>
            </Lungs>
            <BreathIndicator name="Indicator" picking-mode="Ignore">
                <Bindings>
                    <ui:DataBinding property="Radius" data-source-path="_currentRadius" data-source-type="BreathController, Assembly-CSharp" binding-mode="ToTarget"/>
                </Bindings>
            </BreathIndicator>
            <ui:VisualElement name="LungsButton" picking-mode="Position" style="background-image: url(&quot;project://database/Assets/UI/BreathingUI/lungs.png?fileID=2800000&amp;guid=3ee3f9cd2bcc26a488aae0e83690de07&amp;type=3#lungs&quot;); width: 60%; height: 60%; aspect-ratio: auto; min-width: 60%; min-height: 60%; max-height: none; max-width: none; position: absolute;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
